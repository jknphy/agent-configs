{
  "defaultProvider": "google-vertex",
  "defaultModel": "gemini-3.8-flash",
  "enabledModels": [
    "gemini-3.1-pro-preview",
    "gemini-3.8-flash",
    "claude-sonnet-5-5",
    "claude-haiku-5-5",
    "claude-opus-5-5"
  ],
  "packages": [
    "npm:@twogiants/pi-anthropic-vertex",
    "npm:pi-open-tui",
    "npm:@inobit/pi-themes",
    "npm:@monotykamary/pi-retry",
    "npm:@gotgenes/pi-permission-system",
    "git:github.com/ayghri/i-have-adhd",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "skills/ponytail"
      ]
    },
    "git:github.com/os-autoinst/openQA-skill"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 40000
  },
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "externalEditor": "vim",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "theme": "rosepine",
  "lastChangelogVersion": "1.4.0"
}
